{
  "langrev": "1",
  "warnings": [
    "no-unused-parameter",
    "no-unused-import"
  ],
  "macos-min-version": "27.0",
  "sources": [
    "milktea/**",
    "glaze/**",
    "boba/**",
    "xray/**",
    "src/**",
    "test/**"
